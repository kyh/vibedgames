{
  "name": "@repo/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "clean": "rm -rf .cache .turbo dist node_modules",
    "typecheck": "tsc --noEmit",
    "studio": "drizzle-kit studio --config drizzle.config.local.ts",
    "push": "drizzle-kit push --config drizzle.config.local.ts --force",
    "generate": "pnpm with-env drizzle-kit generate",
    "generate:auth-schema": "echo 'Disabled. @better-auth/cli is stuck at 1.4.21: it emits no account.issuer (required since better-auth 1.7) and strips hand-added indexes, RLS, and the rate_limit table. Running it silently breaks auth. Maintain src/drizzle-schema-auth.ts by hand until the CLI supports 1.7.' && exit 1",
    "push:remote": "dotenv -e ../../.env.production.local -- drizzle-kit push",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@kyh/tsconfig": "catalog:",
    "@types/react": "catalog:",
    "drizzle-kit": "^0.31.10",
    "typescript": "catalog:"
  }
}
