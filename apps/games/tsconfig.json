{
  "extends": "@kyh/tsconfig/base.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types"],
    "noEmit": true
  },
  "include": ["."],
  // tests/ is plain JS and imports the bundled worker out of dist/, which drags
  // the excluded build output back into the program.
  "exclude": ["node_modules", "dist", "tests"]
}
