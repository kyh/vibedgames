{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vibedgames-web",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-04-12",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": true,
  "routes": [
    { "pattern": "vibedgames.com/*", "zone_name": "vibedgames.com" },
    { "pattern": "www.vibedgames.com/*", "zone_name": "vibedgames.com" },
  ],
  "vars": {
    "PRODUCTION_URL": "https://vibedgames.com",
    "R2_BUCKET_NAME": "vibedgames-games",
  },
  // Locally these are read from the repo-root `.env` (process.env, loaded by
  // the `with-env` script); declaring them here is what lets wrangler fold
  // process.env into the Worker binding. In production: `wrangler secret put`.
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "R2_ACCOUNT_ID",
      "R2_ACCESS_KEY_ID",
      "R2_SECRET_ACCESS_KEY",
      "FAL_API_KEY",
      "TYPESAFE_API_KEY",
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vibedgames",
      "database_id": "8aba7674-bee1-4532-b5f0-36243172cf81",
    },
  ],
  "r2_buckets": [
    {
      "binding": "GAMES_BUCKET",
      "bucket_name": "vibedgames-games",
    },
  ],
  // Per-PR Worker Previews (`.github/workflows/preview.yml`). Previews inherit
  // nothing from above: every binding is restated against preview-only
  // resources, so a PR can never write prod D1 or the prod bucket. The workflow
  // creates both if missing and swaps <REPLACE_ME> for the D1 id before
  // building; wrangler refuses to run while the placeholder is still there.
  // Secrets: `wrangler preview base-config secret put <NAME>` once per name in
  // `secrets.required` (preview values, not the prod ones).
  "previews": {
    "vars": {
      // empty so auth takes its base URL from the preview's own host
      "PRODUCTION_URL": "",
      "R2_BUCKET_NAME": "vibedgames-games-preview",
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "vibedgames-preview",
        "database_id": "<REPLACE_ME>",
      },
    ],
    "r2_buckets": [
      {
        "binding": "GAMES_BUCKET",
        "bucket_name": "vibedgames-games-preview",
      },
    ],
  },
}
